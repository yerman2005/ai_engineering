# Copiá este archivo como .env y completá los valores. El archivo .env no se versiona.

# Proveedor del LLM: openai | anthropic
LLM_PROVIDER=openai

# API keys
# OPENAI_API_KEY es obligatoria siempre: se usa para los embeddings (text-embedding-3-small).
OPENAI_API_KEY=
# ANTHROPIC_API_KEY solo si LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Opcional: modelos (si se omiten se usan estos valores por defecto)
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Opcional: reintentos del SDK ante errores de red / 429 y timeout por llamada (segundos)
# LLM_MAX_RETRIES=2
# LLM_TIMEOUT_S=60
