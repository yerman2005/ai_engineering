# Copiá este archivo como .env y completá los valores. El archivo .env no se versiona.

# Proveedor del LLM: openai | anthropic
LLM_PROVIDER=openai

# Embeddings: local | openai
#   local  -> all-MiniLM-L6-v2 incluido en chromadb (CPU, sin API key ni costo). Por defecto.
#   openai -> text-embedding-3-small (requiere OPENAI_API_KEY)
EMBEDDINGS_PROVIDER=local

# API keys: solo la del proveedor que uses
# OPENAI_API_KEY: si LLM_PROVIDER=openai o EMBEDDINGS_PROVIDER=openai
OPENAI_API_KEY=
# ANTHROPIC_API_KEY: si LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Opcional: modelos (si se omiten se usan estos valores por defecto)
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Opcional: reintentos del SDK ante errores de red / 429 y timeout por llamada (segundos)
# LLM_MAX_RETRIES=2
# LLM_TIMEOUT_S=60
