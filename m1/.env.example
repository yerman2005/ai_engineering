# Copiá este archivo como .env y completá los valores. El archivo .env no se versiona.

# Proveedor por defecto: openai | anthropic
LLM_PROVIDER=openai

# API keys (alcanza con la del proveedor que vayas a usar)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Opcional: modelos (si se omiten se usan estos valores por defecto)
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Opcional: resiliencia
# Reintentos automáticos del SDK ante 429, 5xx y errores de red (backoff exponencial)
# LLM_MAX_RETRIES=2
# Timeout por llamada, en segundos (en streaming: espera máxima entre fragmentos)
# LLM_TIMEOUT_S=60
